{
  "name": "angular-shop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/angular-shop/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/angular-shop",
        "browser": "apps/angular-shop/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/angular-shop/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular-shop/public"
          }
        ],
        "styles": [
          "apps/angular-shop/src/styles.scss"
        ],
        "server": "apps/angular-shop/src/main.server.ts",
        "ssr": {
          "entry": "apps/angular-shop/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": []
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "angular-shop:build:production"
        },
        "development": {
          "buildTarget": "angular-shop:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-shop:build",
        "staticFilePath": "dist/apps/angular-shop/browser",
        "spa": true
      }
    }
  }
}
