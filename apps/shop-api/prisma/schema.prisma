// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  uid       Int       @unique @default(autoincrement())
  id        String    @id @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  products Product[]
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  uid           Int       @unique @default(autoincrement())
  id            String    @id @db.Uuid
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  isActive      Boolean   @default(true)
  /// Set once the user follows the link sent at registration. Login is refused until then.
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  adminProfile    Admin?
  customerProfile Customer?
}

model Admin {
  id   String @id @db.Uuid
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Customer {
  id           String @id @db.Uuid
  user         User   @relation(fields: [id], references: [id], onDelete: Cascade)
  phone        String
  addressLine1 String
  addressLine2 String @default("")
  postalCode   String
  city         String

  orders Order[]
}

model Producer {
  uid          Int       @unique @default(autoincrement())
  id           String    @id @db.Uuid
  name         String
  email        String
  phone        String
  tvaNumber    String
  addressLine1 String
  addressLine2 String    @default("")
  postalCode   String
  city         String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  products Product[]
}

enum ProductUnit {
  KG
  BOTTE
  PIECE
  DOUZAINE
  BOUTEILLE
  LOT
}

enum MeasureUnit {
  g
  kg
  ml
  l
}

model Product {
  uid              Int          @unique @default(autoincrement())
  id               String       @id @db.Uuid
  name             String
  price            Decimal      @db.Decimal(10, 2)
  stock            Int
  minStock         Int
  vatRate          Decimal      @db.Decimal(5, 2)
  unit             ProductUnit  @default(KG)
  /// What one sale unit contains: contentItemCount × (contentAmount contentUnit), e.g. 4 × 125 g.
  contentItemCount Int?
  contentAmount    Decimal?     @db.Decimal(10, 3)
  contentUnit      MeasureUnit?
  image            String
  isAvailable      Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime?    @updatedAt

  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Restrict)
  producerId String   @db.Uuid

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String      @db.Uuid
  orderItems OrderItem[]

  @@index([producerId])
  @@index([categoryId])
}

enum OrderStatus {
  /// Placed by the customer, not yet handled by the shop.
  REGISTERED
  IN_PROGRESS
  /// A quantity was changed or a product removed while preparing the order.
  MODIFIED
  /// Waiting for the customer at the shop.
  READY
  /// Picked up by the customer.
  COMPLETED
  CANCELLED
}

model OrderItem {
  uid       Int    @unique @default(autoincrement())
  productId String @db.Uuid
  orderId   String @db.Uuid

  /// Snapshot of the product when ordered: unit price excluding VAT, name and VAT rate.
  price       Decimal   @db.Decimal(10, 2)
  productName String
  vatRate     Decimal   @db.Decimal(5, 2)
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@id([productId, orderId])
}

model Order {
  uid                 Int         @unique @default(autoincrement())
  id                  String      @id @db.Uuid
  /// YYYY-MM-N: N restarts at 1 every month (Europe/Paris), see OrderNumberSequence.
  number              String      @unique
  status              OrderStatus @default(REGISTERED)
  /// Indicative date from which the order can be picked up at the shop.
  estimatedPickupDate DateTime    @db.Date
  createdAt           DateTime    @default(now())
  updatedAt           DateTime?   @updatedAt

  /// Snapshot of the contact and billing address when ordered.
  firstName           String
  lastName            String
  email               String
  phone               String
  billingAddressLine1 String
  billingAddressLine2 String      @default("")
  billingPostalCode   String
  billingCity         String

  /// Null for a guest order.
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?   @db.Uuid

  orderItems OrderItem[]

  @@index([customerId])
}

/// Last order number given for a month: the next order of `period` gets `lastValue + 1`.
model OrderNumberSequence {
  /// YYYY-MM
  period    String @id
  lastValue Int
}
