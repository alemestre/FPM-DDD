// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  uid       Int       @unique @default(autoincrement())
  id        String    @id @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  products Product[]
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  uid          Int       @unique @default(autoincrement())
  id           String    @id @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  adminProfile    Admin?
  customerProfile Customer?
}

model Admin {
  id   String @id @db.Uuid
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Customer {
  id           String @id @db.Uuid
  user         User   @relation(fields: [id], references: [id], onDelete: Cascade)
  phone        String
  addressLine1 String
  addressLine2 String @default("")
  postalCode   String
  city         String

  orders Order[]
}

model Producer {
  uid          Int       @unique @default(autoincrement())
  id           String    @id @db.Uuid
  name         String
  email        String
  phone        String
  tvaNumber    String
  addressLine1 String
  addressLine2 String    @default("")
  postalCode   String
  city         String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  products Product[]
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

model Order {
  uid       Int         @unique @default(autoincrement())
  id        String      @id @db.Uuid
  status    OrderStatus
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String   @db.Uuid
}

enum ProductUnit {
  KG
  BOTTE
  PIECE
  CONDITIONNEMENT
  BOUTEILLE
}

enum QuantityUnit {
  pcs
  g
  ml
  kg
  l
}

model Product {
  uid          Int           @unique @default(autoincrement())
  id           String        @id @db.Uuid
  name         String
  price        Decimal       @db.Decimal(10, 2)
  stock        Int
  minStock     Int
  vatRate      Decimal       @db.Decimal(5, 2)
  unit         ProductUnit   @default(KG)
  quantity     Decimal?      @db.Decimal(10, 3)
  quantityUnit QuantityUnit?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt

  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Restrict)
  producerId String   @db.Uuid

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String   @db.Uuid

  @@index([producerId])
  @@index([categoryId])
}
