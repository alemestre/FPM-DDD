{
  "name": "@fpm/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "serve": "dotenv run -f .env -- nx serve $APP --verbose --port=$DEBUG_PORT",
    "serve:shop-api": "APP=shop-api PORT=3000 DEBUG_PORT=9000 npm run serve",
    "serve:angular-shop": "APP=angular-shop PORT=4200 DEBUG_PORT=9001 npm run serve",
    "reload:node_modules": "if [ -d /node_modules ]; then cmp -s /.nmhash /srv/fpm/.nmhash || (echo 'reloading node_modules!' && rm -rf /srv/fpm/node_modules && cp -R /node_modules /srv/fpm/ && cp /.nmhash /srv/fpm/.nmhash); else [ -d node_modules ] && sha256sum package-lock.json | cmp -s - .nmhash || (echo 'installing node_modules!' && npm ci && sha256sum package-lock.json > .nmhash); fi",
    "test:all": "nx run-many --projects=tag:scope:test --target=test --coverage --verbose --parallel=100% --skip-nx-cache --runInBand --no-cache"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
